  modelPanels: []
  modelLabels:
  - title: "Screw notch"
    description: "Half-moon cut-out held down by the small M.2 screw. Don't overtighten it."
    kind: 4
    center: {x: 0.045, y: 0.5, z: 0.6912}
    facing: {x: 0, y: 0, z: 1}
  - title: "M-key connector"
    description: "Gold edge with a notch (the M key) that fits NVMe M.2 slots. Insert it at about 30 degrees."
    kind: 3
    center: {x: 0.965, y: 0.7, z: 0.6349}
    facing: {x: 0, y: 0, z: 1}
  - title: "Controller"
    description: "The SSD's processor. It manages where your data is stored."
    kind: 0
    center: {x: 0.47, y: 0.5, z: 0.9975}
    facing: {x: 0, y: 0, z: 1}
  - title: "NAND flash"
    description: "Memory chips that keep your files even without power."
    kind: 0
    center: {x: 0.76, y: 0.5, z: 0.9074}
    facing: {x: 0, y: 0, z: 1}
