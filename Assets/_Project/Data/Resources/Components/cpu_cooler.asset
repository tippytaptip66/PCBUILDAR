  - title: "Fin stack"
    description: "Thin aluminum fins. Heat spreads into them and the fan's air carries it away."
    kind: 0
    center: {x: 0.5, y: 0.9417, z: 0.65}
    facing: {x: 0, y: 1, z: 0}
  - title: "Heat pipes"
    description: "Copper pipes move heat from the base up into the fins."
    kind: 0
    center: {x: 0.967, y: 0.06, z: 0.65}
    facing: {x: 1, y: 0, z: 0}
  - title: "Contact plate"
