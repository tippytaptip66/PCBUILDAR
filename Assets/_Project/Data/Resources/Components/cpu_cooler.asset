  m_Name: cpu_cooler
  m_EditorClassIdentifier: Assembly-CSharp::BuildAR.Data.ComponentDefinitionSO
  id: cpu_cooler
  displayName: CPU Cooler
  category: 6
  icon: {fileID: 0}
  mlLabel: cooler
  mlAliases: []
  specChips:
  - AM5
  - 120 mm fan
  - 4-pin PWM
  shortDescription: Pulls heat away from the CPU so it doesn't slow down or overheat.
  whatItDoes: Heat pipes carry heat from the CPU into a stack of metal fins, and
    a fan blows air through the fins.
  keyFacts:
  - Needs thermal paste between it and the CPU
  - Fan cable goes to the CPU_FAN header
  - Bracket must match the socket
  installationSteps:
  - Fit the AM5 mounting bracket.
  - Check thermal paste is on the CPU.
  - Place the cooler and tighten screws diagonally.
  - Connect the fan to CPU_FAN.
  safetyTip: Tighten screws a little at a time in a cross pattern for even pressure.
  model3DPrefab: {fileID: 6239741833812455745, guid: 29f02a263f750e54abab704068016a76, type: 3}
