%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4188eded89992a545a0ee17a3fb13478, type: 3}
  m_Name: motherboard
  m_EditorClassIdentifier: Assembly-CSharp::BuildAR.Data.ComponentDefinitionSO
  id: motherboard
  displayName: Motherboard
  category: 1
  icon: {fileID: 0}
  mlLabel: motherboard
  mlAliases: []
  specChips:
  - AM5
  - ATX
  - DDR5
  - M.2 NVMe
  shortDescription: The main circuit board. Every other part plugs into it.
  whatItDoes: The motherboard connects the CPU, memory, storage, graphics card and
    power, and carries data between them.
  keyFacts:
  - AM5 CPU socket
  - 4 DDR5 DIMM slots
  - PCIe x16 slot for the graphics card
  - M.2 slot for NVMe SSDs
  installationSteps:
  - Install the I/O shield (if separate) in the case.
  - Check the standoffs match the board's screw holes.
  - Lower the board in at an angle so ports go through the I/O shield.
  - "Screw it down \u2014 snug, not tight."
  safetyTip: Make sure standoffs are only under screw holes; an extra standoff can
    short the board.
  model3DPrefab: {fileID: 7625027535818376205, guid: 2027b106443fa2942b1795496e1647b2, type: 3}
  modelRotationEuler: {x: 0, y: 0, z: 0}
  modelFans: []
  modelLightBars: []
  modelPanels: []
  modelLabels:
  - title: "CPU socket"
    description: "AM5 socket. The CPU drops in with zero force while the lever is up."
    kind: 6
    center: {x: 0.555, y: 0.72, z: 0.411}
    facing: {x: 0, y: 0, z: 1}
  - title: "Socket lever"
    description: "Lift it to open the socket; lower it to lock the CPU in."
    kind: 4
    center: {x: 0.425, y: 0.7, z: 0.4132}
    facing: {x: 0, y: 0, z: 1}
  - title: "DIMM slots"
    description: "Four RAM slots: A1, A2, B1, B2. With two sticks, use A2 and B2."
    kind: 6
    center: {x: 0.225, y: 0.7, z: 0.4661}
    facing: {x: 0, y: 0, z: 1}
  - title: "Retention clips"
    description: "The clips at the slot ends click shut when the RAM is fully seated."
    kind: 4
    center: {x: 0.225, y: 0.915, z: 0.4548}
    facing: {x: 0, y: 0, z: 1}
  - title: "PCIe x16 slot"
    description: "The long slot for the graphics card. A latch at the end locks the card in."
    kind: 6
    center: {x: 0.64, y: 0.41, z: 0.527}
    facing: {x: 0, y: 0, z: 1}
  - title: "M.2 slot"
    description: "Under this heatsink: the slot for an NVMe SSD. The heatsink keeps the drive cool."
    kind: 6
    center: {x: 0.63, y: 0.3, z: 0.4401}
    facing: {x: 0, y: 0, z: 1}
  - title: "Second PCIe slot"
    description: "For another expansion card. The graphics card goes in the top slot."
    kind: 6
    center: {x: 0.64, y: 0.2, z: 0.2441}
    facing: {x: 0, y: 0, z: 1}
  - title: "Rear I/O ports"
    description: "USB, network, audio and video ports that show through the back of the case."
    kind: 5
    center: {x: 0.94, y: 0.77, z: 0.9919}
    facing: {x: 0, y: 0, z: 1}
  - title: "VRM heatsinks"
    description: "Cool the power circuits that feed the CPU."
    kind: 0
    center: {x: 0.55, y: 0.93, z: 0.7451}
    facing: {x: 0, y: 0, z: 1}
  - title: "Chipset heatsink"
    description: "Covers the chipset, the chip that runs the extra USB, SATA and PCIe connections."
    kind: 0
    center: {x: 0.23, y: 0.17, z: 0.7956}
    facing: {x: 0, y: 0, z: 1}
  - title: "CMOS battery"
    description: "A coin cell that keeps the BIOS clock and settings while the PC is unplugged."
    kind: 0
    center: {x: 0.38, y: 0.07, z: 0.4105}
    facing: {x: 0, y: 0, z: 1}
  connectionPoints: []
