  modelLightBars: []
  modelPanels: []
  modelLabels:
  - title: "Heat spreader"
    description: "Metal lid (IHS) that carries heat from the chip to the cooler. Thermal paste goes here."
    kind: 2
    center: {x: 0.5, y: 0.5, z: 0.9905}
    facing: {x: 0, y: 0, z: 1}
  - title: "Capacitors"
    description: "Tiny parts around the lid. AM5 CPUs have them on top, so keep thermal paste off them."
    kind: 0
    center: {x: 0.27, y: 0.055, z: 0.3516}
    facing: {x: 0, y: 0, z: 1}
  - title: "Substrate"
    description: "The green circuit board the chip sits on. Hold the CPU by these edges."
    kind: 0
    center: {x: 0.05, y: 0.5, z: 0.5025}
    facing: {x: 0, y: 0, z: 1}
  - title: "Contact pads"
    description: "Hundreds of gold contacts underneath connect the CPU to the socket. Never touch them."
    kind: 1
    center: {x: 0.5, y: 0.5, z: 0.0148}
    facing: {x: 0, y: 0, z: -1}
